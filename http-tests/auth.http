### Login as ADMIN
# @name loginAdmin
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "admin.admin",
  "password": "admin"
}

### Login as CLUB_MANAGER
# @name loginManager
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "carlos.manager",
  "password": "manager"
}

### Logout (send the token from login response)
POST http://localhost:8080/api/auth/logout
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "token": "{{token}}"
}

### Create an ADMIN user
POST http://localhost:8080/api/users
Content-Type: application/json
Authorization: Bearer :token

{
  "name": "Admin",
  "surname": "Principal",
  "documentNumber": "00000001",
  "username": "admin",
  "password": "admin123",
  "role": "ADMIN"
}

### Create a CLUB_MANAGER user (associated with club 1)
POST http://localhost:8080/api/users
Content-Type: application/json
Authorization: Bearer :token

{
  "name": "Carlos",
  "surname": "Garcia",
  "documentNumber": "87654321",
  "username": "carlos.manager",
  "password": "manager",
  "role": "CLUB_MANAGER",
  "clubId": 1
}

### Get current logged-in user info
GET http://localhost:8080/api/auth/me
Authorization: Bearer :tokenManager

### Get all users (ADMIN only)
GET http://localhost:8080/api/users
Authorization: Bearer {{token}}

### Get user by ID (ADMIN only, replace with actual ID)
GET http://localhost:8080/api/users/REPLACE_WITH_USER_ID
Authorization: Bearer {{token}}
