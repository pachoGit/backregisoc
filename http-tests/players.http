### Register a new player (without photos)
POST http://localhost:8080/api/players
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "clubId": 1,
  "firstName": "Juan",
  "lastName": "Pérez",
  "documentNumber": "12345678",
  "age": 26,
  "dateOfBirth": "1998-05-15",
  "position": "FORWARD"
}

### Register a player with photo URLs
POST http://localhost:8080/api/players
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "clubId": 2,
  "firstName": "Luis",
  "lastName": "Sanches",
  "documentNumber": "97654399",
  "age": 24,
  "dateOfBirth": "2000-30-05",
  "position": "MIDFIELDER",
  "photoUrl": "https://storage.example.com/photos/pedro.jpg",
  "documentFrontUrl": "https://ciudadania.pe/actividades-interactivas/static/media/ordenar8.155d0398e5f8867aac02.png",
  "documentBackUrl": "https://storage.example.com/documents/carlos-dni-back.jpg"
}

### Upload photos for an existing player (replace with actual ID)
POST http://localhost:8080/api/players/REPLACE_WITH_PLAYER_ID/photos
Content-Type: multipart/form-data; boundary=boundary
Authorization: Bearer {{token}}

--boundary
Content-Disposition: form-data; name="photo"; filename="player.jpg"
Content-Type: image/jpeg

< ./player.jpg
--boundary
Content-Disposition: form-data; name="documentFront"; filename="dni-front.jpg"
Content-Type: image/jpeg

< ./dni-front.jpg
--boundary
Content-Disposition: form-data; name="documentBack"; filename="dni-back.jpg"
Content-Type: image/jpeg

< ./dni-back.jpg
--boundary--

### Get all players for a club (replace with actual club ID)
GET http://localhost:8080/api/players?clubId=1
# Authorization: Bearer {{token}}

### Get player by ID (replace with actual ID)
GET http://localhost:8080/api/players/1
Authorization: Bearer {{token}}

### Update player (replace with actual ID)
PUT http://localhost:8080/api/players/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "firstName": "Juan",
  "lastName": "Pérez Actualizado",
  "documentNumber": "12345678",
  "age": 27,
  "dateOfBirth": "1998-05-15",
  "position": "DEFENDER"
}

### Delete a player (replace with actual ID)
DELETE http://localhost:8080/api/players/1
Authorization: Bearer {{token}}
