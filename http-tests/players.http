### Register a new player (with photo files)
POST http://localhost:8080/api/players
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="request"
Content-Type: application/json

{
  "clubId": "REPLACE_WITH_CLUB_ID",
  "name": "Juan Pérez",
  "dateOfBirth": "1998-05-15",
  "position": "FORWARD"
}
--boundary
Content-Disposition: form-data; name="photo"; filename="player.jpg"
Content-Type: image/jpeg

< ./player.jpg
--boundary
Content-Disposition: form-data; name="documentFront"; filename="dni-front.jpg"
Content-Type: image/jpeg

< ./dni-front.jpg
--boundary
Content-Disposition: form-data; name="documentBack"; filename="dni-back.jpg"
Content-Type: image/jpeg

< ./dni-back.jpg
--boundary--

### Register a player without photos (JSON only alternative)
POST http://localhost:8080/api/players
Content-Type: multipart/form-data; boundary=simple

--simple
Content-Disposition: form-data; name="request"
Content-Type: application/json

{
  "clubId": "REPLACE_WITH_CLUB_ID",
  "name": "Carlos López",
  "dateOfBirth": "2000-01-20",
  "position": "MIDFIELDER"
}
--simple--

### Get all players for a club (replace with actual club ID)
GET http://localhost:8080/api/players?clubId=REPLACE_WITH_CLUB_ID

### Get player by ID (replace with actual ID)
GET http://localhost:8080/api/players/REPLACE_WITH_PLAYER_ID

### Update player (replace with actual ID)
PUT http://localhost:8080/api/players/REPLACE_WITH_PLAYER_ID
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="request"
Content-Type: application/json

{
  "name": "Juan Pérez Actualizado",
  "dateOfBirth": "1998-05-15",
  "position": "DEFENDER"
}
--boundary--

### Delete a player (replace with actual ID)
DELETE http://localhost:8080/api/players/REPLACE_WITH_PLAYER_ID
