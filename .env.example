# Copia este fichero a `.env` y ajusta los valores:
#   cp .env.example .env
# Nunca subas `.env` a git (ya está en .gitignore).
#
# Perfil activo: local | dev | prod
SPRING_PROFILES_ACTIVE=local

# Puerto HTTP (en Cloud Run lo define la plataforma con PORT, no lo pongas tú)
SERVER_PORT=8080

# --- Base de datos (MySQL en los 3 entornos) ---
# local: BD `regisoc` en localhost (docker compose la crea).
# dev:   BD `regisoc_dev` en localhost, o el servidor dev con DB_URL propio.
# prod:  Cloud SQL (DB_URL/DB_USERNAME/DB_PASSWORD) o Railway (vars MYSQL* del plugin MySQL).
# En Railway NO definas DB_URL: el plugin inyecta MYSQLHOST/MYSQLPORT/MYSQLDATABASE/
# MYSQLUSER/MYSQLPASSWORD y la app arma la URL JDBC sola. Solo añade SPRING_PROFILES_ACTIVE=prod
# y JWT_SECRET en las Variables del servicio.
DB_URL=jdbc:mysql://localhost:3306/regisoc?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# Ejemplo dev contra servidor compartido:
# DB_URL=jdbc:mysql://dev.tu-dominio.com:3306/regisoc_dev?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=secret
# Alias aceptado: DB_USER (si defines ambos, manda DB_USERNAME)
# DB_USER=root
DB_DRIVER=com.mysql.cj.jdbc.Driver

# MySQL del docker-compose (crea `regisoc` + `regisoc_dev` vía docker/mysql/init)
MYSQL_ROOT_PASSWORD=secret
MYSQL_DATABASE=regisoc

# --- JWT ---
# Genera uno seguro con: openssl rand -base64 48
# En prod es OBLIGATORIO (la app no arranca sin él).
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=1800000

# --- Opcionales ---
SHOW_SQL=true
# DB_POOL_SIZE=10
# DB_POOL_MIN_IDLE=2
# FLYWAY_ENABLED=true
# JAVA_OPTS=-Xms256m -Xmx512m
